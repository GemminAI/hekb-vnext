{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensos:contracts/nvs/gate-verdict/1",
  "title": "GateVerdict (gate-verdict/1) — the result of one Gate call on one envelope",
  "description": "One document for one Gate decision (design U6T-1 v0.1 section 3; parent design U5/U6-T v0.2 section 4.4, v0.3 section 4.3): the result, the envelope it is about, what went in, the checker and the environment that ran it. The layers are L1 (the IC-00 envelope rule), L2 (the payload) and L3 (the window space, only for a msr.trajectory-window payload); a failed L1 leaves L2 and L3 not_run. NOT in it: eligibility or admission to a chain (D-185 (9)) and any time (DC-T1-2: the same inputs give the same bytes). WAIVED is not a result of gate-verdict/1 (waived is always empty until U6T-6). verdict_sha256 is the SHA-256 of the JCS (RFC 8785, contracts/jcs.py) of the document without that key; it detects accidental damage only and is not a defence against forgery. Every object is closed (additionalProperties false). This file is new in U6T-1a; no IC-00 / IC-02 file or lock is changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict_version",
    "subject",
    "result",
    "layers",
    "codes",
    "violations",
    "unverifiable",
    "waived",
    "rules",
    "inputs",
    "gate",
    "produced_by",
    "verdict_sha256"
  ],
  "properties": {
    "verdict_version": { "const": "gate-verdict/1" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_id", "envelope_sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "content_id": { "$ref": "#/$defs/contentId" },
        "envelope_sha256": { "$ref": "#/$defs/sha256hex" }
      }
    },
    "result": { "enum": ["PASS", "PASS_UNVERIFIED", "FAIL"] },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L1", "L2", "L3"],
      "properties": {
        "L1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "codes"],
          "properties": {
            "status": { "enum": ["PASS", "FAIL"] },
            "codes": { "$ref": "#/$defs/codes" }
          }
        },
        "L2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "kind", "codes"],
          "properties": {
            "status": { "enum": ["PASS", "PASS_UNVERIFIED", "FAIL", "not_run"] },
            "kind": { "enum": ["hidden_trajectory", "ic02", null] },
            "codes": { "$ref": "#/$defs/codes" }
          },
          "if": { "properties": { "status": { "const": "not_run" } }, "required": ["status"] },
          "then": { "properties": { "kind": { "const": null }, "codes": { "maxItems": 0 } } },
          "else": { "properties": { "kind": { "enum": ["hidden_trajectory", "ic02"] } } }
        },
        "L3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "codes"],
          "properties": {
            "status": {
              "enum": ["PASS", "PASS_UNVERIFIED", "FAIL", "not_run", "not_applicable"]
            },
            "codes": { "$ref": "#/$defs/codes" }
          },
          "if": {
            "properties": { "status": { "enum": ["not_run", "not_applicable"] } },
            "required": ["status"]
          },
          "then": { "properties": { "codes": { "maxItems": 0 } } }
        }
      },
      "if": {
        "properties": { "L1": { "properties": { "status": { "const": "FAIL" } } } },
        "required": ["L1"]
      },
      "then": {
        "properties": {
          "L2": { "properties": { "status": { "const": "not_run" } } },
          "L3": { "properties": { "status": { "const": "not_run" } } }
        }
      },
      "else": {
        "properties": {
          "L2": { "properties": { "status": { "enum": ["PASS", "PASS_UNVERIFIED", "FAIL"] } } },
          "L3": { "properties": { "status": { "enum": ["PASS", "PASS_UNVERIFIED", "FAIL", "not_applicable"] } } }
        }
      }
    },
    "codes": {
      "description": "The code of every violation of every layer, each once, in the order of the code points.",
      "$ref": "#/$defs/codes"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "code", "message"],
        "properties": {
          "layer": { "enum": ["L1", "L2", "L3"] },
          "code": { "type": "string", "minLength": 1 },
          "message": {
            "description": "Free text of the checker (it may carry a jsonschema message); never compared.",
            "type": "string"
          }
        }
      }
    },
    "unverifiable": {
      "description": "As the checker returned it, with its layer. Every row is in the UNVERIFIABLE catalogue (contracts.hidden_trajectory.UNVERIFIABLE_CATALOG, DC-7) -- the Gate refuses to make a verdict otherwise.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "check", "reason"],
        "properties": {
          "layer": { "enum": ["L2", "L3"] },
          "check": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "waived": {
      "description": "Always empty in gate-verdict/1 (waive is U6T-6).",
      "type": "array",
      "maxItems": 0
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ic00_contract_version", "payload_schema"],
      "properties": {
        "ic00_contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "payload_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookup", "lookup_sha256", "stored", "blobs_checked", "contract_facts_sha256"],
      "properties": {
        "lookup": {
          "description": "artifact_id -> the stored parent's ids, as given to the Gate (method A of IC-00: trusted).",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^art:[0-9a-f]{64}$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["content_id", "seq", "observation_id"],
              "properties": {
                "content_id": { "$ref": "#/$defs/contentId" },
                "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "observation_id": { "type": "string", "pattern": "^obs:[0-9a-f]{64}$" }
              }
            }
          }
        },
        "lookup_sha256": { "$ref": "#/$defs/sha256hex" },
        "stored": {
          "description": "artifact_id of the stored envelopes given to the window check, in the order of the code points.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactId" }
        },
        "blobs_checked": {
          "description": "SHA-256 of each Blob given to the Gate, in the order of the code points.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256hex" }
        },
        "contract_facts_sha256": {
          "description": "SHA-256 of the JCS of the contract_facts given; null if none were.",
          "oneOf": [{ "$ref": "#/$defs/sha256hex" }, { "type": "null" }]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker", "runtime", "unverifiable_catalog"],
      "properties": {
        "checker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_sha256", "sensos_commit", "nvs_runtime_commit", "files"],
          "properties": {
            "bundle_sha256": { "$ref": "#/$defs/sha256hex" },
            "sensos_commit": {
              "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
            },
            "nvs_runtime_commit": {
              "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
            },
            "files": {
              "description": "The files of the checker bundle (gate-checker-bundle/1), in the order of (repo, path).",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["repo", "path", "sha256"],
                "properties": {
                  "repo": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "$ref": "#/$defs/sha256hex" }
                }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "implementation", "packages", "platform"],
          "properties": {
            "python": { "type": "string", "minLength": 1 },
            "implementation": { "type": "string", "minLength": 1 },
            "packages": {
              "type": "object",
              "additionalProperties": false,
              "required": ["jsonschema", "referencing"],
              "properties": {
                "jsonschema": { "type": "string", "minLength": 1 },
                "referencing": { "type": "string", "minLength": 1 }
              }
            },
            "platform": {
              "description": "Informative; never a condition of a comparison.",
              "type": "object",
              "additionalProperties": false,
              "required": ["system", "machine"],
              "properties": {
                "system": { "type": "string" },
                "machine": { "type": "string" }
              }
            }
          }
        },
        "unverifiable_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256hex" }
          }
        }
      }
    },
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "verdict_sha256": { "$ref": "#/$defs/sha256hex" }
  },
  "allOf": [
    {
      "description": "FAIL exactly when a violation exists.",
      "if": { "properties": { "violations": { "minItems": 1 } }, "required": ["violations"] },
      "then": { "properties": { "result": { "const": "FAIL" } } },
      "else": { "properties": { "result": { "enum": ["PASS", "PASS_UNVERIFIED"] } } }
    },
    {
      "description": "PASS_UNVERIFIED exactly when nothing is violated and something is unverifiable.",
      "if": {
        "properties": { "violations": { "maxItems": 0 }, "unverifiable": { "minItems": 1 } },
        "required": ["violations", "unverifiable"]
      },
      "then": { "properties": { "result": { "const": "PASS_UNVERIFIED" } } },
      "else": {
        "if": {
          "properties": { "violations": { "maxItems": 0 }, "unverifiable": { "maxItems": 0 } },
          "required": ["violations", "unverifiable"]
        },
        "then": { "properties": { "result": { "const": "PASS" } } }
      }
    }
  ],
  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactId": { "type": "string", "pattern": "^art:[0-9a-f]{64}$" },
    "contentId": { "type": "string", "pattern": "^cnt:[0-9a-f]{64}$" },
    "codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
